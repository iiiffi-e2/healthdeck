# Database
DATABASE_URL="postgresql://user:password@localhost:5432/healthdeck?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Google OAuth (required for sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Health API — finalize scopes/endpoints when credentials are available
# https://developers.google.com/health
GOOGLE_HEALTH_API_ENABLED="false"

# Token encryption (32-byte hex or base64 key for AES-256-GCM)
TOKEN_ENCRYPTION_KEY=""

# Use mock health data when Google Health API is not configured
USE_MOCK_HEALTH_DATA="true"
