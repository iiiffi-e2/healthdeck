# Database
DATABASE_URL="postgresql://user:password@localhost:5432/healthdeck?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Google OAuth (required for sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Google Health API — https://developers.google.com/health
# Set both to true/false below to sync live data from Google Health API v4
GOOGLE_HEALTH_API_ENABLED="true"

# Token encryption (32-byte hex or base64 key for AES-256-GCM) — required in production
TOKEN_ENCRYPTION_KEY=""

# false = call health.googleapis.com; true = demo data only
USE_MOCK_HEALTH_DATA="false"
